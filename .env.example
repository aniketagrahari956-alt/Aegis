# App settings
APP_NAME="AI Cyber Threat Detection Framework"
HOST=0.0.0.0
PORT=8000

# Security settings
JWT_SECRET=super_secret_jwt_key_change_me_in_production_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database settings
# Use postgresql://postgres:postgres@db:5432/threat_db for docker-compose
# Use sqlite:///./threat_db.sqlite for local SQLite fallback / dev
DATABASE_URL=sqlite:///./threat_db.sqlite

# Ingestion & Simulator Settings
SIMULATOR_RATE=5
